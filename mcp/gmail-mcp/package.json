{
  "name": "google-workspace-mcp",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "allowScripts": {},
  "overrides": {
    "google-auth-library": "10.5.0"
  }
}
