# Host ports intentionally use uncommon values to reduce collision risk.
OTEL_HTTP_PORT=24318
GRAFANA_PORT=23000

# Cowork's exporter may run inside a VM. 0.0.0.0 lets it reach this host
# through the Windows LAN IP if localhost does not work.
OTEL_BIND_ADDRESS=0.0.0.0

# Keep the dashboard local to this PC by default.
GRAFANA_BIND_ADDRESS=127.0.0.1

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=P@ssw0rd
