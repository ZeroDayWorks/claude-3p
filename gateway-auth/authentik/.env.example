# =============================================================================
# Authentik deployment environment variables.
#
# Copy to .env and fill in. NEVER commit the resulting .env.
# Generate secrets with: ./scripts/generate-secrets.sh
# =============================================================================

# ---- Hostname of the Authentik reverse proxy (public FQDN) -----------------
AUTH_DOMAIN=auth.company.com

# ---- PostgreSQL --------------------------------------------------------------
# User and DB may stay as defaults. Password MUST be generated (openssl rand -base64 36).
PG_USER=authentik
PG_DB=authentik
PG_PASS=CHANGE_ME_generate_with_openssl_rand_base64_36

# ---- Authentik core ----------------------------------------------------------
# 128-char hex string. Generate with: openssl rand -hex 64
# Rotate carefully - this key encrypts field-level secrets in the DB.
AUTHENTIK_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_64

# Log level: trace|debug|info|warning|error
AUTHENTIK_LOG_LEVEL=info

# Send anonymous crash telemetry to goauthentik.io (default off for privacy).
AUTHENTIK_ERROR_REPORTING__ENABLED=false

# Avatar strategy: initials | gravatar | none | <URL template>
AUTHENTIK_AVATARS=initials

# ---- Outbound email (used for password reset, invitations, notifications) ---
# Leave blank to disable outbound email.
AUTHENTIK_EMAIL__HOST=
AUTHENTIK_EMAIL__PORT=587
AUTHENTIK_EMAIL__USERNAME=
AUTHENTIK_EMAIL__PASSWORD=
AUTHENTIK_EMAIL__USE_TLS=true
AUTHENTIK_EMAIL__USE_SSL=false
AUTHENTIK_EMAIL__FROM=authentik@company.com

# ---- TLS certificates for nginx (paths on the host) --------------------------
# These are consumed by nginx/conf.d/auth.company.com.conf via envsubst-style
# substitution done at deploy time (see docs/installation.md).
TLS_CERT_PATH=/etc/nginx/certs/auth.company.com.fullchain.pem
TLS_KEY_PATH=/etc/nginx/certs/auth.company.com.key.pem

# ---- Reserved for future use (NOT read by Authentik) -------------------------
# Optional: pin a specific tag override for CI images. Leave blank in prod.
AUTHENTIK_IMAGE_TAG_OVERRIDE=
